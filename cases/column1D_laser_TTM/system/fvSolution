FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-08;
        relTol          0.0;
        maxIter         100;
        minIter         0;     // was 3: forced BiCGStab iterations on an already-converged alpha system (residual ~1e-21) break down to NaN

        nAlphaCorr      2;
        nAlphaSubCycles 2;              // alpha sub-cycles per time step
        cAlpha          2.0;            // interface compression strength
        icAlpha         0;
        scAlpha         0;
        compressionLimiter 0.50;         // Caps phic relative to |phi|
        MULESCorr       true;
        nLimiterIter    3;
        alphaApplyPrevCorr true;
        sharpeningScheme standard;
        thinFilmCoeff   0.0;
    }

    p_rgh
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-6;
        relTol          0.001;
        maxIter         200;
        nPreSweeps      1;
        nPostSweeps     3;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 20;
        agglomerator    faceAreaPair;
        mergeLevels     2;
        relaxationFactor 0.6;
    }

    p_rghFinal
    {
        $p_rgh;
        tolerance   1e-8;
        relTol      0;
    }

    "U.*"
   {
            solver      smoothSolver;
            smoother    symGaussSeidel;
            nSweeps     2;
            tolerance   1e-06;
            relTol      0.1;
            maxIter     200;
    }

    T
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        nSweeps         6;
        tolerance       1e-6;
        relTol          0.001;             // Tightened relative convergence
        maxIter         50;             // Increased iteration limit
        minIter         0;     // was 3: forced BiCGStab iterations on an already-converged alpha system (residual ~1e-21) break down to NaN
    }

        Te
        {
            $T;
            tolerance       1e-14;   // a 1e-6/1e-8 tolerance let the solver skip (0 iterations) post-pulse steps, freezing the temperature
            relTol          0;
            minIter         1;
        }

        Tl
        {
            $T;
            tolerance       1e-14;   // a 1e-6/1e-8 tolerance let the solver skip (0 iterations) post-pulse steps, freezing the temperature
            relTol          0;
            minIter         1;
        }
}

PIMPLE
{
    momentumPredictor           true;
    nOuterCorrectors            10;           
    nCorrectors                 8;
    nNonOrthogonalCorrectors    3;

    outerCorrectorResidualControl
    {
        "(U|p_rgh)"  { tolerance 1e-4;  relTol 0.1; }
    }

    residualControl
    {
        "alpha.*" { tolerance 1e-7;  relTol 0.0; }  // Relaxed from 1e-8
        p_rgh     { tolerance 1e-4;  relTol 0.05; }  // Relaxed for stability
        U         { tolerance 1e-3;  relTol 0.1; }   // Relaxed from 1e-4
        Te        { tolerance 1e-6;  relTol 0.0;  }  // Relaxed from 1e-8
        Tl        { tolerance 1e-6;  relTol 0.0;  }  // Relaxed from 1e-8
        T         { tolerance 1e-6;  relTol 0.05;  } // Relaxed from 1e-7

    }

    p_rghRefCell                0;
    p_rghRefValue               101325;
}

relaxationFactors
{
    fields
    {
        p_rgh           0.3;
        "alpha.*"       0.5;
    }
    equations
    {
        U               0.7;
        T               0.2;
        Te              0.4;
        Tl              0.4;
        "alpha.*"       0.5;
        ".*Final"       0.8;
    }
}

// Pressure relaxation control

compInterFoamCoeffs
{
    maxReasonableVelocity  1000;
    maxVelocity            0;
    maxPressureGradient    1e16;
    // Interface clamp settings

    // Pressure clamp settings
    pressureClamp      true;
    maxPressure        5.0e9;
    minPressure       -1.0e7;

    // Density clamp settings

    // Bounds on 1/A (inactive while enableRAUClamp is false)

    // Diagonal safety (keep this)
    minUEqnDiag        1e-9;

    // RELAX RESIDUAL TARGETS
    // Under-relaxation of U and time smoothing of the recoil force
    URelaxationFactor      0.3;   // Aggressive U equation relaxation
    // pRelaxationFactor removed: the pressure-correction matrix must not be relaxed (breaks mass conservation)
}
