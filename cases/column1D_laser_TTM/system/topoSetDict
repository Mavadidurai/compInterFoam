FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(

    // Receiver zone (y = 0-8 um), for post-processing
    {
        name substrateSet;
        type cellSet;
        action new;
        source boxToCell;
        sourceInfo
        {
            // receiver block
            box (0 0 0) (50.0e-06 8.0000e-06 10.0e-06);
        }
    }

    {
        name substrate;
        type cellZoneSet;
        action new;
        source setToCellZone;
        sourceInfo
        {
            set substrateSet;
        }
    }
);

