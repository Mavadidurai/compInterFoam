FoamFile

{

    version     2.0;

    format      ascii;

    class       dictionary;

    object      blockMeshDict;

}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

 

scale 1e-6; // coordinates in micrometers

 

// 1-D column through the layers of the reference case: 0.25 x 0.25 um, 212 cells,
// 32 cells (2.23 nm) across the film; gap and glass graded to 4.95 nm at the film.
// Layers, bottom to top (y in um):
//   0.0000 - 8.0000    receiver
//   8.0000 - 20.0000   gap
//  20.0000 - 20.0714   titanium film, 71.4 nm
//  20.0714 - 32.0714   gas standing in for the donor glass

vertices

(

    // y0 = 0.0000 (substrate/receiver bottom)

    (24.875   0.0000  4.875)  (25.125  0.0000  4.875)  (25.125  0.0000  5.125)  (24.875   0.0000  5.125)

 

    // y1 = 8.0000 (substrate top / air gap bottom)

    (24.875   8.0000  4.875)  (25.125  8.0000  4.875)  (25.125  8.0000  5.125)  (24.875   8.0000  5.125)

 

    // y2 = 20.0000 (air gap top / Ti film bottom)

    (24.875  20.0000  4.875)  (25.125 20.0000  4.875)  (25.125 20.0000  5.125)  (24.875  20.0000  5.125)

 

    // y3 = 20.0714 (Ti film top) - 71.4 nm thick film

    (24.875  20.0714  4.875)  (25.125 20.0714  4.875)  (25.125 20.0714  5.125)  (24.875  20.0714  5.125)

 

    // y4 = 32.0714 (donor glass top)

    (24.875  32.0714  4.875)  (25.125 32.0714  4.875)  (25.125 32.0714  5.125)  (24.875  32.0714  5.125)

);

 

blocks

(

    //                y-low face       y-high face        Nx   Ny   Nz   grading

    hex ( 0  3  2  1   4  7  6  5)   ( 1 1  20)  simpleGrading (1 1 1)  // Substrate (receiver)

    hex ( 4  7  6  5   8 11 10  9)   ( 1 1  80)  simpleGrading (1 1 0.0066667)  // Air gap (12 µm)

    hex ( 8 11 10  9  12 15 14 13)   ( 1 1  32)  simpleGrading (1 1 1)  // Ti film (71.4 nm, thin layer)

    hex (12 15 14 13  16 19 18 17)   ( 1 1  80)  simpleGrading (1 1 150)  // Donor glass (12 µm)

);

 

edges ();

 

boundary

(

    // Symmetry planes (external boundaries only)

    left          { type symmetryPlane; faces ((0 3 7 4)(4 7 11 8)(8 11 15 12)(12 15 19 16)); }

    right         { type symmetryPlane; faces ((1 5 6 2)(5 9 10 6)(9 13 14 10)(13 17 18 14)); }

    front         { type symmetryPlane; faces ((0 4 5 1)(4 8 9 5)(8 12 13 9)(12 16 17 13)); }

    back          { type symmetryPlane; faces ((3 2 6 7)(7 6 10 11)(11 10 14 15)(15 14 18 19)); }

 

    // Substrate at bottom, donor at top (external faces only)

    substrate     { type wall;  faces ((0 3 2 1)); }      // BOTTOM - receiver substrate

    donor         { type wall;  faces ((16 17 18 19)); }   // TOP - transparent donor substrate

);

 

mergePatchPairs();

 

