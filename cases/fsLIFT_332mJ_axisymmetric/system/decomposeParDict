FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// tools/run_case.sh sets numberOfSubdomains to the number of processes.
numberOfSubdomains 4;

// Serial and parallel runs agree to 8 digits, so the decomposition method
// only changes the run speed.
method          scotch;

