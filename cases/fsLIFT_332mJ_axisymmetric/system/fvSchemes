FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    // localEuler (LTS) uses a per-cell pseudo-time step for every ddt()
    // discretization, decoupled from runTime.value(). This solver gates
    // laser pulses, phase-change kinetics, and two-temperature subcycling
    // on runTime.value()/deltaT, so LTS silently desynchronizes the fields
    // from the physical time being reported -- it does not improve
    // conservation. Use Euler.
    default          Euler;
    ddt(alpha)       Euler;
    ddt(rho,U)       Euler;
    ddt(rho)         Euler;
}

gradSchemes
{
    default         Gauss linear;
    grad(U)         cellLimited Gauss linear 0.5;
    grad(alpha.metal) cellLimited Gauss linear 1;
    grad(Te)        cellLimited Gauss linear 0.5;
    grad(Tl)        cellLimited Gauss linear 0.5;
    // If you have a single-phase gas T field too:
    grad(T)         cellLimited Gauss linear 0.5;
}

divSchemes
{
    default                          Gauss linear;

    // Interface transport
    div(phi,alpha)                   Gauss vanLeer;
    div(phir,alpha)                  Gauss interfaceCompression; // compression flux
    div(phi,alpha.metal)             Gauss vanLeer;
    div(phir,alpha.metal)            Gauss interfaceCompression; // compression flux
    div(phi,alpha.air)               Gauss vanLeer;

    // Momentum
    div(rhoPhi,U)                    Gauss linearUpwind grad(U);

    div(phi,T)       Gauss limitedLinear 1;           // Reduce numerical diffusion
    div(phi,Te)      Gauss limitedLinear 1;
    div(phi,Tl)      Gauss limitedLinear 1;

    // Pressure
    div(phi,p_rgh)                   Gauss upwind;
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;       // viscous term
}
laplacianSchemes
{
    default                          Gauss linear corrected;

    // Pressure Laplacians
    laplacian((1|A(U)),p_rgh)        Gauss linear corrected;
    laplacian(rAU,p_rgh)             Gauss linear corrected;
    laplacian((1|A(U)),p)            Gauss linear corrected;

    // Momentum diffusion
    laplacian(nuEff,U)               Gauss linear corrected;
    laplacian((rho*nuEff),U)         Gauss linear corrected;

    // Temperature diffusion
    laplacian(alphaEff,T)            Gauss linear limited 0.1;  // Tighter limiter for non-orth
    laplacian(kappaEff,T)            Gauss linear limited 0.1;  // Tighter limiter for non-orth
    laplacian(kappa,T)               Gauss linear limited 0.1;  // Tighter limiter for non-orth

    // Two-temperature model diffusion
    laplacian(ke,Te)                 Gauss linear limited 0.1;  // Tighter limiter for non-orth
    laplacian(kl,Tl)                 Gauss linear limited 0.1;  // Tighter limiter for non-orth
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

wallDist
{
    method          meshWave;                          // robust wall-distance method
}

fluxRequired
{
    default         no;
    p_rgh           yes;
    alpha.metal     yes;
    alpha.air       yes;
}
