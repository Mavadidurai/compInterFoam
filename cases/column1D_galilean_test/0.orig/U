FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 -170 0);   // Galilean test: the whole column moves at -170 m/s

boundaryField
{
  left     { type symmetryPlane; }
  right     { type symmetryPlane; }
  front     { type symmetryPlane; }
  back     { type symmetryPlane; }

    substrate     { type zeroGradient; }   // outflow
    donor
    {
        type            fixedValue;          // uniform inflow
        value           uniform (0 -170 0);
    }
}


