FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     compInterFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         2e-8;            // tools/run_case.sh sets this per stage

deltaT          1e-15;         // Base time step (1 fs)
adjustTimeStep  yes;           // adaptive time step
maxCo           0.2;          // Relaxed slightly to avoid needless clipping
thermalFluxRelax 0.15;          // Stronger damping of interface heat flux
maxThermalCourant 0.5;         // Tightened for thermal stability
maxAlphaCo      0.5;          // Allow modest interface Courant growth
maxDeltaT       2.5e-12;       // step change applied at 1.0 ns: capillary limit ~4.4e-12 s
minDeltaT       5e-16;         // Keep floor above numerical noise threshold
maxDi           20;  // read and logged only; not used by the time-step control

// Laser and phase-change time window
laserStartTime      0;
laserEndTime    5e-8;          // [s] end of the window; it also ends evaporation and recoil, so it is set beyond the run end. The Gaussian pulse itself is over after +-5 sigma

verbose         false;           // diagnostics off for speed

// ADAPTIVE OUTPUT - more frequent during active phase, less during cooling
writeControl    adjustableRunTime;
writeInterval   2e-10;           // step change applied at 1.0 ns: disk budget (132k cells)
purgeWrite      0;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   8;             // Increased precision for longer runs
fileHandler     uncollated;

runTimeModifiable yes;
enableLiftProcessTracker true;

// Phase change (evaporation) at the metal surface
phaseChangeCoeffs
{
    model               clausius_clapeyron;  // saturation pressure from the Clausius-Clapeyron relation
    hf                  [0 2 -2 0 0 0 0] 9.1e6;   // J/kg (Ti vaporisation)
    gasConstant         [0 2 -2 -1 0 0 0] 174;    // J/kg/K (Ti vapor)
    Tsol                [0 0 0 1 0 0 0] 1941;     // K
    Tvap                [0 0 0 1 0 0 0] 3560;     // K
    p_ref               [1 -1 -2 0 0 0 0] 101325; // Pa at Tvap
    // Kinetic theory parameters
evaporationCoeff       0.18;     // evaporation coefficient beta in the Hertz-Knudsen flux
    //momentumAccom       0.18;     // Momentum accommodation

    //windowWidth         100;
    dtFloor             1e-15;
    // NOTE: The solver expects maxSource in volumetric units [W/m^3].
    // 1e25 W/m^3 is far above the largest source of this case, so the cap does not act.
    maxSource           [1 -1 -3 0 0 0 0]   1e25;
    minCoefficient      [1 -1 -3 0 0 0 0] 1e6;          // ignored when maxSource is given
    onlyAboveVapor      false;
    phaseChangeVolumeSource false;   // no artificial vapour volume (evaporated mass leaves; recoil carries the momentum)
    metalFractionCutoff 1e-6;
    // active time window
    tStart              (0);
    tEnd                (5e-8);   // was 2e-10: evaporation must continue while the surface is hot
}

// Mass transfer time window
massTransferCoeffs
{
    tStart  (0);
    tEnd    (5e-8);   // was 2e-10: evaporation must continue while the surface is hot
    rateMax 1e11;
}



// Evaporation, recoil and vapour pocket at the interface
useAdvancedInterfaceCapturing  true;
advancedInterfaceCapturing
{
    model               kinetic_theory;  // Hertz-Knudsen evaporation flux
    stickingCoeff       0.18;
    momentumAccommodationCoeff         1.0;   // physical recoil (gap side); glass side = vapour pocket
    // Option: confined vapour at the glass side pushes with the
    // full p_sat instead of 0.54*p_sat: factor = 1/0.54. Direction = towards the glass.
    confinedVapourFactor      1.0;   // replaced by the vapour pocket below
    confinedVapourDirection   (0 1 0);
    confinedVapourPocket     // trapped vapour between the glass and the film (docs/MODEL.md)
    {
        enabled       true;
        minThickness  1e-9;    // initial pocket thickness h0 [m]
        metalDensity  4506;    // evaporated metal volume adds to the pocket [kg/m3]
        mode          local;   // one vapour column per radial bin; "uniform" = one 0-D pocket for the whole spot
        binWidth      1e-7;    // radial bin width [m] (2 cells)
        maxRadius     1e-5;    // [m]
        filmMinHeight 9e-6;    // only metal above y = 9 um is the donor film (receiver top at 8 um)
    }
    recoilCoefficient     0.54;          // p_recoil = 0.54*p_sat (Anisimov/Knight Knudsen layer)
    recoilMax             5.0e9;      // [Pa] older name of the recoil bound; maxRecoilPressure below takes precedence
    clampRecoil           false;
    scaleRecoilMax        false;
    recoilTempOffset      0;        // [K] shift of the recoil onset temperature
    phaseChangeTempOffset 0;      // [K] shift of the evaporation onset temperature
    recoilRelax           0.7;      // under-relaxation of the recoil pressure between iterations
    alphaMin              0.01;
    alphaMax              1;
    maxPhysicalTemperature  10000;  // [K] highest temperature used in the saturation pressure and evaporation flux
   // pressureScale [1 -1 -2 0 0 0 0] 0.6;  // NEW: Corrects Knight formula
    massRateEps           1e-15;        // smallest evaporation rate treated as non-zero
        // Physical limits
    maxRecoilPressure   5.0e9;    // [Pa] bound on the recoil pressure (5 GPa)
}

// Temperature bounds
enableTClamp    false;
minT            200;           // Allow cooling below room temp
maxT            50000;          // safety bound; 10 kK was too low (it was reached with the 10 nm absorption depth)

// Two-temperature model (electrons and lattice)
twoTemperatureProperties
{

    // Linear electronic heat capacity: Ce = γTe
    Ce
    {
        type        polynomial;
        value       0;
        coeffs
        (
            (0   0)  // Constant term = 0
            (318 1)  // Linear term: Ce = 318 · Te [J/m³/K²], Sommerfeld fit for Ti (Hobmaier et al. 2026)
        );
    }

    // Electron-lattice coupling: the table of the reference case capped at 2.5e18 W/(m3 K), the
    // first-principles peak for Ti of Hobmaier et al. (2026). Same inputs as case C of
    // tools/ttm_parameter_sensitivity.py, so the 1-D solution there checks the early heating.
G
{
    type table;
    values
    (
        (300      1.0e18)
        (1000     2.5e18)
        (2000     2.5e18)
        (3000     2.5e18)
        (5000     2.5e18)
        (7000     2.5e18)
        (10000    2.5e18)
        (15000    2.5e18)
        (20000    2.5e18)
    );
}

    Cl  [1 -1 -2 -1 0 0 0] 2.5e6;
    De  [0  2 -1  0 0 0 0] 1e-4;
    ke0  18.9;   // Drude k_e = ke0*Te/Tl; electronic conductivity at 300 K, kept from the reference case (independent of Ce)
    kl  [1  1 -3 -1 0 0 0] 4.5;    // Ti lattice (phonon) conductivity: k_total(21.9) minus electronic part (Wiedemann-Franz)
    advectTemperatures  true;      // transport Te/Tl with the mixture flux (ejected material keeps its heat)

    gasMetalExchangeCoeff
    {
        type        kapitza;    // acoustic-mismatch gas-metal exchange; acts only in interface cells with 0.5 <= alpha < 1 and Tl < gasMetalCutoffTemperature (docs/CODE_REVIEW.md 10.1, A10)
        Z_metal     2.3e7;      // Ti acoustic impedance [Pa·s/m]
        Z_gas       403;        // acoustic impedance of air [Pa·s/m]: 1.1614 kg/m3 x 347 m/s
        rho_metal   4506;       // Ti density [kg/m^3]
        rho_gas     1.1614;     // gas density [kg/m^3], as thermophysicalProperties.air
        maxTemperature 0;      // Optional cap [K] (0 => no cap)
    }
    gasMetalCutoffTemperature 3560;
    minMetalFractionForExchange 0.5;
    minGasMetalExchangeCoeff [1 -1 -3 -1 0 0 0] 1e6;
    maxGasMetalExchangeCoeff [1 -1 -3 -1 0 0 0] 5e8;
    maxGasMetalHeatFlux    5e8;   // Surface heat flux cap [W/m²]

    // Temperature bounds: safety limits, set high enough that they do not act
    minTe           200;
    maxTe           50000;       // safety bound
    maxTl           50000;       // safety bound
    ambientTemperature 300;
    temperatureDifferenceFloor 10.0;                     // Guard against Te/Tl collapse

    // ADAPTIVE MICRO-STEPPING
    electronSubCycles        4;
    minElectronSubCycles     2;
    maxElectronSubCycles     20;     // Allow rapid transients
    maxElectronDeltaT        [0 0 1 0 0 0 0] 1e-15;  // Guard rapid transients

    nInnerCouplingSweeps         3;  // More coupling iterations
    innerCouplingResidualTol     1e-4; // convergence tolerance of the sweeps

    klHighTThreshold 1000;
    klExponent       0.5;

    metalFractionFloor      1e-9;
    metalFractionCutoff     1e-6;
    metalAmbientBlendWidth  1e-3;
    CvolGasFloor    1e6;  // J/m^3/K floor for gas cells

    energyTolerance         0.02;    // Relaxed for long runs
    energyDiagnostics       false;
    temperatureDiagnostics  false;   // Reduce output volume
    energyAudit             false;
}
enhancedLIFTPhysics
{
    // Phase explosion and spinodal decomposition
    phaseExplosionCoeffs
    {
        enablePhaseExplosion   false;   // unverified sub-model; its mass source caused a numerical runaway with the physical laser inputs; the pocket represents the vaporization
        T_critical             8980;       // Ti critical temperature [K] as cited by Hobmaier et al. 2026 (sub-model off)
        T_spinodal             8082;       // 0.9 * T_critical [K]
        p_critical             1.2e8;      // Ti critical pressure [Pa]
        tau_explosion          1e-12;      // Explosion timescale [s]
        explosionMultiplier    100.0;      // Mass flux enhancement factor
    }
    // Plasma formation and ionization
    plasmaIonizationCoeffs
    {
        enablePlasmaModel      false;   // unverified sub-model; its mass source caused a numerical runaway with the physical laser inputs; the pocket represents the vaporization
        ionizationEnergy       1.093e-18;  // Ti: 6.82 eV = 1.093e-18 J
        T_ionization           30000;      // Ionization threshold [K]
        atomicMass             7.95e-26;   // Ti: 47.867 amu [kg]
        atomicNumberDensity    5.68e28;    // Ti: ~5.68e28 atoms/m^3
    }

    // Droplet/jet breakup (Weber number criterion)
    dropletBreakupCoeffs
    {
        enableDropletBreakup   true;
        We_critical            10.0;       // Critical Weber number
        minJetDiameter         1e-7;       // 100 nm [m]
        maxJetDiameter         10e-6;      // 10 μm [m]
        breakupTimeCoeff       1.0;        // Timescale coefficient
    }
}
// Clean monitoring functions
functions
{
    axisLine
    {
        type            sets;
        libs            (sampling);
        writeControl    timeStep;
        writeInterval   20;
        interpolationScheme cell;
        setFormat       raw;
        fields          (alpha.metal Tl U p);
        sets
        {
            axis
            {
                type    uniform;
                axis    y;
                start   (25e-9 7.9e-6 0);
                end     (25e-9 20.2e-6 0);
                nPoints 3000;
            }
        }
    }
