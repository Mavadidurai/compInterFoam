FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      alpha.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

// Gas fraction: 1 - alpha.metal (set by setFieldsDict)
internalField   uniform 1;

boundaryField
{
    axis 	{ type empty; }
    right    { type zeroGradient; }   // the film continues beyond r = 8 um; inletOutlet cut it open (it created a false film rim at the outer boundary)
    front 	{ type wedge; }
    back 	{ type wedge; }
    substrate   { type zeroGradient;  }
    donor 	{ type zeroGradient;  }
}
// ************************************************************************* //
