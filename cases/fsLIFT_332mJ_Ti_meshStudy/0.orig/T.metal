FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      T.metal;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;     // initial temperature [K]

boundaryField
{
  axis      { type empty; }
  right    { type inletOutlet; inletValue uniform 300; value uniform 300; }
  front     { type wedge; }
  back      { type wedge; }

substrate { type fixedValue; value uniform 300; }
donor
{
    type            zeroGradient;
}

}



